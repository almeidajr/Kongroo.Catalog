{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "HybridCache": {
    "DefaultEntryOptions": {
      "Expiration": "00:05:00",
      "LocalCacheExpiration": "00:01:00"
    }
  },
  "AllowedHosts": "*"
}
